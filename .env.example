# Desktop development only: absolute directory for profiles.json and profile databases.
# Used by pnpm tauri dev; leave unset to use the development app-data directory.
# New profile databases use profiles/<uuid>/app.db under this directory.
# WF_DATA_DIR is ignored by release, packaged, and mobile builds.
# WF_DATA_DIR=/absolute/path/to/wealthfolio-dev

# Wealthfolio Connect - Required for cloud sync feature
CONNECT_AUTH_URL=https://your-auth-provider.example.com
CONNECT_AUTH_PUBLISHABLE_KEY=your-publishable-key
# Optional overrides; public production defaults live in config/connect.defaults.json.
# CONNECT_API_URL=https://your-connect-api.example.com
# CONNECT_OAUTH_CALLBACK_URL=https://your-connect.example.com/deeplink

# Direct Connect transfers use the public production hosts from that same file.
# For staging/custom transfers, export CONNECT_STORAGE_ALLOWED_HOSTS into the
# Cargo build environment; putting it only in .env does not embed an override.
# Host overrides replace the defaults. See docs/connect-source-builds.md.

# Private file storage (transaction attachments and procurement photos).
# S3 is the default when WF_S3_* is configured; otherwise files stay local.
# Set WF_FILE_STORAGE_BACKEND=local to keep new uploads local explicitly.
# Existing files continue to use their recorded backend; no automatic migration.
# These are runtime server/desktop settings. Never use VITE_ for credentials.
# WF_FILE_STORAGE_BACKEND=s3
# WF_S3_URL=https://s3.eu-west-par.io.cloud.ovh.net
# WF_S3_BUCKET=your-private-bucket
# WF_S3_ACCESS=your-access-key
# WF_S3_SECRET=your-secret-key
# Optional for OVH endpoints (inferred from the hostname); required elsewhere.
# WF_S3_REGION=eu-west-par
# WF_S3_USER is an OVH account label and is not needed for S3 request signing.
# Images are saved as WebP quality 50, halved until the longest edge <= 1000px.
# Small images are not enlarged. PDFs and 480px preview rendering are unchanged.
